 "settings": [
  {
   "name": "model",
   "display": "setting.model",
   "description": "setting.model.about",
   "type": "enum",
   "options": [
    "model1_2",
    "1f_2f",
    "10f_20f",
    "cx",
    "ux",
    "ug",
    "hg",
    "hr",
    "ur",
    "me",
    "ma",
    "mx",
    "mf_fresh",
    "marty"
   ],
   "optionLabels": {
    "model1_2": "setting.model.model1_2",
    "1f_2f": "setting.model.1f_2f",
    "10f_20f": "setting.model.10f_20f",
    "cx": "setting.model.cx",
    "ux": "setting.model.ux",
    "ug": "setting.model.ug",
    "hg": "setting.model.hg",
    "hr": "setting.model.hr",
    "ur": "setting.model.ur",
    "me": "setting.model.me",
    "ma": "setting.model.ma",
    "mx": "setting.model.mx",
    "mf_fresh": "setting.model.mf_fresh",
    "marty": "setting.model.marty"
   },
   "default": "model1_2",
   "sync": true
  },
  {
   "name": "freeTownsRoms",
   "display": "setting.freetownsroms",
   "description": "setting.freetownsroms.about",
   "type": "enum",
   "options": [
    "off",
    "forTsugaru",
    "forUNZ"
   ],
   "optionLabels": {
    "off": "setting.freetownsroms.off",
    "forTsugaru": "setting.freetownsroms.fortsugaru",
    "forUNZ": "setting.freetownsroms.forunz"
   },
   "default": "off",
   "sync": true,
   "exposedWhen": {
    "setting": "model",
    "is": "model1_2"
   }
  },
  {
   "name": "cpuMhz",
   "display": "setting.cpumhz",
   "description": "setting.cpumhz.about",
   "type": "enum",
   "options": [
    "auto",
    "16",
    "20",
    "25",
    "33",
    "40",
    "50",
    "66",
    "100"
   ],
   "optionLabels": {
    "auto": "setting.cpumhz.auto"
   },
   "default": "auto",
   "sync": true
  },
  {
   "name": "ramMb",
   "display": "setting.rammb",
   "description": "setting.rammb.about",
   "type": "enum",
   "options": [
    "auto",
    "1",
    "2",
    "4",
    "6",
    "8",
    "10",
    "12",
    "16",
    "20",
    "24",
    "32",
    "48",
    "64",
    "96"
   ],
   "optionLabels": {
    "auto": "setting.rammb.auto"
   },
   "default": "auto",
   "sync": true
  },
  {
   "name": "fpu",
   "display": "setting.fpu",
   "description": "setting.fpu.about",
   "type": "enum",
   "options": [
    "auto",
    "off",
    "on"
   ],
   "optionLabels": {
    "auto": "setting.fpu.auto",
    "off": "setting.fpu.off",
    "on": "setting.fpu.on"
   },
   "default": "auto",
   "sync": true
  },
  {
   "name": "speedMode",
   "display": "setting.speedmode",
   "description": "setting.speedmode.about",
   "type": "enum",
   "options": [
    "auto",
    "off",
    "on"
   ],
   "optionLabels": {
    "auto": "setting.speedmode.auto",
    "off": "setting.speedmode.off",
    "on": "setting.speedmode.on"
   },
   "default": "auto",
   "sync": true
  },
  {
   "name": "bootDevice",
   "display": "setting.bootdevice",
   "description": "setting.bootdevice.about",
   "type": "enum",
   "options": [
    "auto",
    "cdrom",
    "floppy1",
    "floppy2"
   ],
   "optionLabels": {
    "auto": "setting.bootdevice.auto",
    "cdrom": "setting.bootdevice.cdrom",
    "floppy1": "setting.bootdevice.floppy1",
    "floppy2": "setting.bootdevice.floppy2"
   },
   "default": "auto",
   "sync": true
  },
  {
   "name": "portA",
   "display": "setting.porta",
   "description": "setting.porta.about",
   "type": "enum",
   "options": [
    "auto",
    "pad",
    "pad6",
    "martyPad",
    "mouse",
    "none"
   ],
   "optionLabels": {
    "auto": "setting.porta.auto",
    "pad": "setting.porta.pad",
    "pad6": "setting.porta.pad6",
    "martyPad": "setting.porta.martypad",
    "mouse": "setting.porta.mouse",
    "none": "setting.porta.none"
   },
   "default": "auto",
   "sync": true
  },
  {
   "name": "portB",
   "display": "setting.portb",
   "description": "setting.portb.about",
   "type": "enum",
   "options": [
    "auto",
    "pad",
    "pad6",
    "martyPad",
    "mouse",
    "none"
   ],
   "optionLabels": {
    "auto": "setting.portb.auto",
    "pad": "setting.portb.pad",
    "pad6": "setting.portb.pad6",
    "martyPad": "setting.portb.martypad",
